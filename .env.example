# Copy this file to `.env` and fill in real values. NEVER COMMIT `.env`.

# ─── Database (Prisma + SQLite for local; swap for Postgres in prod) ─────────
DATABASE_URL="file:./prisma/dev.db"

# ─── Blockchain RPC ──────────────────────────────────────────────────────────
# Local Hardhat node: `npx hardhat node` then use http://127.0.0.1:8545
# Sepolia testnet:    https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Polygon Mumbai:     https://rpc-mumbai.maticvigil.com
RPC_URL=http://127.0.0.1:8545

# ─── Deployer wallet ─────────────────────────────────────────────────────────
# WARNING: never commit a real private key. For local dev, you can use Hardhat
# account #0: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# (this is a publicly-known test key — fine for localhost only).
# For Sepolia / Mumbai use a fresh wallet that ONLY holds testnet ETH.
PRIVATE_KEY=

# ─── Authentication (better-auth + GitHub OAuth) ─────────────────────────────
# Generate a random 32-byte hex secret: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── IPFS pinning (Pinata) ───────────────────────────────────────────────────
# Get free keys at https://app.pinata.cloud/keys
PINATA_API_KEY=
PINATA_SECRET=

# ─── Deployed contract addresses ─────────────────────────────────────────────
# Filled in automatically by scripts/deploy-*.ts after deployment.
# The NEXT_PUBLIC_ prefix exposes them to the browser bundle.
NEXT_PUBLIC_STAKE_REGISTRY_ADDRESS=
NEXT_PUBLIC_PHISHBLOCK_REGISTRY_ADDRESS=
NEXT_PUBLIC_REPUTATION_SYSTEM_ADDRESS=
NEXT_PUBLIC_EVIDENCE_VALIDATOR_ADDRESS=
NEXT_PUBLIC_MOCK_TOKEN_ADDRESS=
PHB_TOKEN_ADDRESS=
REPUTATION_NFT_ADDRESS=
PHISHDAO_ADDRESS=
TIMELOCK_ADDRESS=

# ─── Contract verification ───────────────────────────────────────────────────
# Get a key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
