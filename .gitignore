# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── testing ─────────────────────────────────────────────────────────────────
/coverage

# ─── next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/

# ─── production ──────────────────────────────────────────────────────────────
/build

# ─── secrets — NEVER COMMIT ─────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ─── databases (local dev) ──────────────────────────────────────────────────
prisma/dev.db
prisma/dev.db-journal
*.sqlite
*.sqlite-journal

# ─── hardhat ─────────────────────────────────────────────────────────────────
cache/
artifacts/
typechain/
typechain-types/
deployments/
gas-report.txt
coverage.json

# ─── misc ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── typescript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── editor ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
